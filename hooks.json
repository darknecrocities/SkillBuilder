{
  "skillbuilder-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/pre_tool_use_safety.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "skillbuilder-line-guard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/post_tool_use_line_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/post_tool_use_line_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "skillbuilder-session-start": {
    "enabled": true,
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/session_start_health.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
